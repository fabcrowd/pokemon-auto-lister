# PokeGrade API
PGAI_KEY=

# VellumAI local identity (dual with PokeGrade, or solo when quota circuit opens)
VELLUM_AI_ENABLED=false
VELLUM_AI_URL=http://127.0.0.1:8787
VELLUM_AI_REQUIRE_OCR=true
# dual | local-only | pokegrade-only
IDENTITY_MODE=dual
# Hours before auto-clearing PokeGrade quota circuit
POKEGRADE_CIRCUIT_TTL_HOURS=24

# eBay Sell/Inventory API (OAuth)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_CATEGORY_ID=
EBAY_MERCHANT_LOCATION_KEY=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=

# TCGPlayer official pricing API (optional — Collectr CSV can replace for comps)
TCGPLAYER_PUBLIC_KEY=
TCGPLAYER_PRIVATE_KEY=

# Collectr private app API (api-v2.getcollectr.com) — preferred when set.
# Copy JWT from browser localStorage.collectrToken.token while logged into app.getcollectr.com
COLLECTR_TOKEN=
COLLECTR_USER_ID=
COLLECTR_COLLECTION_ID=
COLLECTR_API_BASE_URL=https://api-v2.getcollectr.com
# Portfolio re-sync interval (default 6h)
COLLECTR_SYNC_INTERVAL_MS=21600000

# Collectr CSV fallback when COLLECTR_TOKEN is unset
COLLECTR_CSV=data/collectr-export.csv
# Auto-import when this file is newer (default: ~/Downloads/export.csv) — skipped when token set
COLLECTR_WATCH_PATH=

# Dashboard server (LAN bind)
PORT=3000
HOST=0.0.0.0

# PokéWallet TCGPlayer USD comps (https://www.pokewallet.io/api-docs)
POKEWALLET_API_KEY=

# JustTCG live USD comps (https://justtcg.com/docs/quickstart)
JUSTTCG_API_KEY=

# RapidAPI Pokémon TCG comps (https://rapidapi.com/tcggopro/api/pokemon-tcg-api)
RAPIDAPI_KEY=
# API returns EUR for many markets — convert to USD for Mercari (default 1.09)
RAPIDAPI_EUR_USD=1.09

# Optional folder-drop intake (local inbox). Prefer a local folder — Windows Shared Albums often never download.
INBOX_DIR=autolist-inbox
# Main iCloud Photos library used by dashboard "Download photos" (copies recent JPGs into INBOX_DIR).
ICLOUD_PHOTOS_DIR=%USERPROFILE%\iCloudPhotos\Photos

# Mercari scalper / sniper (auto-heart underpriced listings). Default off.
# Shares the Mercari Chrome profile with the sell-side lister (mutex).
SNIPER_ENABLED=false
# Optional override of config/sniper-strategies.json intervalMs (default 600000 = 10 min)
# SNIPER_INTERVAL_MS=600000
